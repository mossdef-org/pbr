Testing pbr.user.tunnel-dns.uc: map entries that are not an address[#port] and interfaces without a device are skipped with a warning, and the dnsmasq server= lines and the pbr_output exemption use the interface's device, not its UCI name. A policy name cannot add lines of its own, and every domain of a multi-domain dhcp server= entry is checked.

-- Testcase --
// The shipped file is read with the real fs; the module cache is then dropped so that
// the include's own require('fs') gets the mock again and never touches the host.
let src = global.mocklib.require('fs').readfile('files/usr/share/pbr/pbr.user.tunnel-dns.uc');
delete global.modules.fs;
let placeholder = "\t\t// wg0: '10.0.0.1',\n";
let entries = "\t\tvpn: '10.8.0.1#5353',\n" +
	"\t\tvpnserver: 'fd00::53',\n" +
	"\t\twan: 'resolver.example',\n" +
	"\t\tlan: '10.0.0.300',\n" +
	"\t\twan6: '10.0.0.1#70000',\n" +
	"\t\twg0: '10.9.0.1',\n";
let checks = [];
push(checks, ['map_placeholder_found', index(src, placeholder) >= 0]);

let rules = [];
let api = {
	compat: 38,
	table: 'inet fw4',
	nft4: (r) => push(rules, r),
	nft6: (r) => push(rules, r),
};
global._orig_loadstring(replace(src, placeholder, entries))()(api);

let dnsmasq = global.mocklib.read_captured('/var/run/pbr.dnsmasq') || '';
let lines = filter(split(dnsmasq, '\n'), (l) => l != '');
let has_line = (l) => index(lines, l) >= 0;
let warnings = map(filter(global.mocklib.argvs(), (a) => type(a) == 'array' && a[0] == 'logger'), (a) => a[3]);
let has_warning = (w) => index(warnings, 'tunnel-dns: ' + w) >= 0;
let rule4 = filter(rules, (r) => index(r, ' ip daddr ') >= 0)[0] || '';
let rule6 = filter(rules, (r) => index(r, ' ip6 daddr ') >= 0)[0] || '';

// Lines name the device (vpn is tun0, vpnserver is wg1), with a port only when not 53.
push(checks, ['vpn_line_uses_device', has_line('server=/example.com/10.8.0.1#5353@tun0 # VPN dom')]);
push(checks, ['ipv6_resolver_line', has_line('server=/example.edu/fd00::53@wg1 # V6 dom')]);
push(checks, ['no_uci_name_in_lines', index(dnsmasq, '@vpn') < 0]);
push(checks, ['first_policy_wins', length(filter(lines, (l) => index(l, 'server=/example.com/') == 0)) == 1]);
push(checks, ['ip_literal_not_a_domain', index(dnsmasq, '192.0.2.1') < 0]);
push(checks, ['disabled_policy_ignored', index(dnsmasq, 'disabled.example') < 0]);

// Skipped entries: no lines, one warning each, and nothing else breaks.
push(checks, ['hostname_skipped', index(dnsmasq, 'example.net') < 0 && has_warning("wan: 'resolver.example' is not an address[#port]; skipped")]);
push(checks, ['bad_address_skipped', has_warning("lan: '10.0.0.300' is not an address[#port]; skipped")]);
push(checks, ['bad_port_skipped', has_warning("wan6: '10.0.0.1#70000' is not an address[#port]; skipped")]);
push(checks, ['no_device_skipped', index(dnsmasq, 'example.info') < 0 && has_warning('wg0: no device (interface down or unknown); skipped')]);
push(checks, ['valid_entries_not_warned', length(filter(warnings, (w) => match(w, /^tunnel-dns: vpn(server)?:/))) == 0]);
// example.org is the second domain of a multi-domain dhcp entry.
push(checks, ['dhcp_server_entry_warned', has_line('server=/example.org/10.8.0.1#5353@tun0 # VPN dom') && has_warning('example.org also has a dhcp server entry; remove it, or answers will mix')]);

// A control character in a policy name must not start a line of its own.
push(checks, ['name_newline_stays_in_comment', has_line('server=/example.biz/10.8.0.1#5353@tun0 # Inject server=/injected.test/9.9.9.9')]);
push(checks, ['no_injected_line', length(filter(lines, (l) => index(l, 'server=/') != 0)) == 0 && index(dnsmasq, '\nserver=/injected.test/') < 0]);

// The pbr_output exemption matches the device too, per family.
push(checks, ['nft4_uses_device', index(rule4, 'oifname . ip daddr . th dport { "tun0" . 10.8.0.1 . 5353 }') >= 0]);
push(checks, ['nft6_uses_device', index(rule6, 'oifname . ip6 daddr . th dport { "wg1" . fd00::53 . 53 }') >= 0]);
push(checks, ['two_rules_only', length(rules) == 2]);

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("tunnel_dns: %d/%d passed\n", pass, pass + fail);
-- End --

