-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let rt_tables = global.mocklib.read_captured('/etc/iproute2/rt_tables') || '';

let gateway_profile = null;
let auto_profile = null;
for (let gw in (result?.gateways || [])) {
	if (gw.name == 'wg') auto_profile = gw;
	if (gw.name == 'wg_gw_10_8_0_2') gateway_profile = gw;
}

let checks = [
	['result_not_null', result != null],
	['auto_profile_exists', auto_profile != null],
	['gateway_profile_exists', gateway_profile != null],
	['gateway_profile_iface', gateway_profile?.interface == 'wg'],
	['gateway_profile_gateway', gateway_profile?.gateway_ipv4 == '10.8.0.2'],
	['gateway_profile_table', gateway_profile?.table_name == 'wg_gw_10_8_0_2'],
	['gateway_profile_mark_distinct', gateway_profile?.mark && auto_profile?.mark && gateway_profile.mark != auto_profile.mark],
	['nft_has_gateway_define', index(nft_content, 'define pbr_wg_gw_10_8_0_2_chain = pbr_mark_') >= 0],
	['nft_has_gateway_policy', index(nft_content, '"Route WG Peer"') >= 0],
	['rt_tables_has_gateway', index(rt_tables, 'pbr_wg_gw_10_8_0_2') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_gateway_override: %d/%d passed\n", pass, pass + fail);
-- End --

