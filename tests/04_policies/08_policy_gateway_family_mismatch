-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let profile = null;
for (let gw in (result?.gateways || [])) {
	if (gw.name == 'wg_gw_10_8_0_2') profile = gw;
}

let checks = [
	['result_not_null', result != null],
	['profile_exists', profile != null],
	['profile_gateway4_override', profile?.gateway == '10.8.0.2' && profile?.gateway_ipv4 == '10.8.0.2'],
	['profile_gateway6_auto', profile?.gateway6 == '' && profile?.gateway_ipv6 == '2001:db8::1'],
	['nft_has_ipv4_rule', index(nft_content, 'ip daddr { 198.51.100.10 } goto ' + 'pbr_mark_' + profile?.mark + ' comment "Gateway IPv4 With IPv6 Fallback"') >= 0],
	['nft_has_ipv6_rule', index(nft_content, 'ip6 daddr { 2001:db8:100::10 } goto ' + 'pbr_mark_' + profile?.mark + ' comment "Gateway IPv4 With IPv6 Fallback"') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_gateway_family_mismatch: %d/%d passed\n", pass, pass + fail);
-- End --

