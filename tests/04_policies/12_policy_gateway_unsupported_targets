-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let errors = result?.errors || [];
let unsupported_errors = filter(errors, e => e.code == 'errorPolicyGatewayUnsupportedMode');

let checks = [
	['result_not_null', result != null],
	['all_special_targets_rejected', length(unsupported_errors) == 3],
	['ignore_rejected', length(filter(unsupported_errors, e => e.info == 'Ignore With Gateway')) == 1],
	['tor_rejected', length(filter(unsupported_errors, e => e.info == 'Tor With Gateway')) == 1],
	['xray_rejected', length(filter(unsupported_errors, e => e.info == 'Xray With Gateway')) == 1],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_gateway_unsupported_targets: %d/%d passed\n", pass, pass + fail);
-- End --

