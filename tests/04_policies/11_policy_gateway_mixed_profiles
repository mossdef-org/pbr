-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let rt_tables = global.mocklib.read_captured('/etc/iproute2/rt_tables') || '';

let auto_profile = null;
let gateway4_profile = null;
let gateway6_profile = null;
let dual_profile = null;
for (let gw in (result?.gateways || [])) {
	if (gw.name == 'wg') auto_profile = gw;
	if (gw.name == 'wg_gw_10_8_0_2') gateway4_profile = gw;
	if (gw.name == 'wg_gw6_2001_db8_2') gateway6_profile = gw;
	if (gw.name == 'wg_gw_10_8_0_3_gw6_2001_db8_3') dual_profile = gw;
}

let distinct_marks = auto_profile?.mark && gateway4_profile?.mark && gateway6_profile?.mark && dual_profile?.mark &&
	auto_profile.mark != gateway4_profile.mark &&
	auto_profile.mark != gateway6_profile.mark &&
	auto_profile.mark != dual_profile.mark &&
	gateway4_profile.mark != gateway6_profile.mark &&
	gateway4_profile.mark != dual_profile.mark &&
	gateway6_profile.mark != dual_profile.mark;

let checks = [
	['result_not_null', result != null],
	['auto_profile_exists', auto_profile != null],
	['gateway4_profile_exists', gateway4_profile != null],
	['gateway6_profile_exists', gateway6_profile != null],
	['dual_profile_exists', dual_profile != null],
	['gateway4_values', gateway4_profile?.gateway == '10.8.0.2' && gateway4_profile?.gateway6 == '' && gateway4_profile?.gateway_ipv4 == '10.8.0.2' && gateway4_profile?.gateway_ipv6 == '2001:db8::1'],
	['gateway6_values', gateway6_profile?.gateway == '' && gateway6_profile?.gateway6 == '2001:db8::2' && gateway6_profile?.gateway_ipv4 == '10.8.0.1' && gateway6_profile?.gateway_ipv6 == '2001:db8::2'],
	['dual_values', dual_profile?.gateway == '10.8.0.3' && dual_profile?.gateway6 == '2001:db8::3'],
	['all_distinct_marks', distinct_marks],
	['rt_tables_has_auto', index(rt_tables, 'pbr_wg') >= 0],
	['rt_tables_has_gateway4', index(rt_tables, 'pbr_wg_gw_10_8_0_2') >= 0],
	['rt_tables_has_gateway6', index(rt_tables, 'pbr_wg_gw6_2001_db8_2') >= 0],
	['rt_tables_has_dual', index(rt_tables, 'pbr_wg_gw_10_8_0_3_gw6_2001_db8_3') >= 0],
	['nft_has_default_policy', index(nft_content, 'ip saddr { 192.168.1.0/24 } goto ' + 'pbr_mark_' + auto_profile?.mark + ' comment "Route Default Profile"') >= 0],
	['nft_gateway4_has_ipv4', index(nft_content, 'ip daddr { 198.51.100.10 } goto ' + 'pbr_mark_' + gateway4_profile?.mark + ' comment "Route Gateway IPv4 Only"') >= 0],
	['nft_gateway4_has_ipv6', index(nft_content, 'ip6 daddr { 2001:db8:100::10 } goto ' + 'pbr_mark_' + gateway4_profile?.mark + ' comment "Route Gateway IPv4 Only"') >= 0],
	['nft_gateway6_has_ipv4', index(nft_content, 'ip daddr { 198.51.100.20 } goto ' + 'pbr_mark_' + gateway6_profile?.mark + ' comment "Route Gateway IPv6 Only"') >= 0],
	['nft_gateway6_has_ipv6', index(nft_content, 'ip6 daddr { 2001:db8:100::20 } goto ' + 'pbr_mark_' + gateway6_profile?.mark + ' comment "Route Gateway IPv6 Only"') >= 0],
	['nft_dual_has_ipv4', index(nft_content, 'ip daddr { 198.51.100.30 } goto ' + 'pbr_mark_' + dual_profile?.mark + ' comment "Route Gateway Dual Stack"') >= 0],
	['nft_dual_has_ipv6', index(nft_content, 'ip6 daddr { 2001:db8:100::30 } goto ' + 'pbr_mark_' + dual_profile?.mark + ' comment "Route Gateway Dual Stack"') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_gateway_mixed_profiles: %d/%d passed\n", pass, pass + fail);
