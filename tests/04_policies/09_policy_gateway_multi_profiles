-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let rt_tables = global.mocklib.read_captured('/etc/iproute2/rt_tables') || '';

let auto_profile = null;
let gateway1_profile = null;
let gateway2_profile = null;
for (let gw in (result?.gateways || [])) {
	if (gw.name == 'wg') auto_profile = gw;
	if (gw.name == 'wg_gw_10_8_0_2') gateway1_profile = gw;
	if (gw.name == 'wg_gw_10_8_0_3') gateway2_profile = gw;
}

let distinct_marks = auto_profile?.mark && gateway1_profile?.mark && gateway2_profile?.mark &&
	auto_profile.mark != gateway1_profile.mark &&
	auto_profile.mark != gateway2_profile.mark &&
	gateway1_profile.mark != gateway2_profile.mark;

let distinct_tables = auto_profile?.table_name && gateway1_profile?.table_name && gateway2_profile?.table_name &&
	auto_profile.table_name != gateway1_profile.table_name &&
	auto_profile.table_name != gateway2_profile.table_name &&
	gateway1_profile.table_name != gateway2_profile.table_name;

let checks = [
	['result_not_null', result != null],
	['auto_profile_exists', auto_profile != null],
	['gateway1_profile_exists', gateway1_profile != null],
	['gateway2_profile_exists', gateway2_profile != null],
	['gateway1_correct_gateway', gateway1_profile?.gateway_ipv4 == '10.8.0.2'],
	['gateway2_correct_gateway', gateway2_profile?.gateway_ipv4 == '10.8.0.3'],
	['all_distinct_marks', distinct_marks],
	['all_distinct_table_names', distinct_tables],
	['nft_has_auto_policy', index(nft_content, '"Route WG Auto"') >= 0],
	['nft_has_gateway1_policy', index(nft_content, '"Route WG Peer 1"') >= 0],
	['nft_has_gateway2_policy', index(nft_content, '"Route WG Peer 2"') >= 0],
	['nft_has_gateway1_define', index(nft_content, 'define pbr_wg_gw_10_8_0_2_chain = pbr_mark_') >= 0],
	['nft_has_gateway2_define', index(nft_content, 'define pbr_wg_gw_10_8_0_3_chain = pbr_mark_') >= 0],
	['rt_tables_has_auto', index(rt_tables, 'pbr_wg') >= 0],
	['rt_tables_has_gateway1', index(rt_tables, 'pbr_wg_gw_10_8_0_2') >= 0],
	['rt_tables_has_gateway2', index(rt_tables, 'pbr_wg_gw_10_8_0_3') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("policy_gateway_multi_profiles: %d/%d passed\n", pass, pass + fail);
-- End --

