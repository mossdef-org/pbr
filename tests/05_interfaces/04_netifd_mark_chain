-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft_content = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let vpn_gw = filter(result?.gateways || [], g => g.name == 'vpn')?.[0];
let vpn_mark = vpn_gw?.mark || '';

let checks = [
	['result_not_null',           result != null],
	['vpn_mark_present',          vpn_mark != ''],
	['vpn_action_create',         vpn_gw?.action == 'create'],
	['vpn_in_ifaces_triggers',    index(result?.ifacesTriggers || '', 'vpn') >= 0],
	['nft_has_vpn_mark_chain',    vpn_mark != '' && index(nft_content, 'add chain inet fw4 pbr_mark_' + vpn_mark) >= 0],
	['nft_policy_goto_vpn_chain', vpn_mark != '' && index(nft_content, 'goto pbr_mark_' + vpn_mark) >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("netifd_mark_chain: %d/%d passed\n", pass, pass + fail);
-- End --

